        def draw_wrapped_text(
            text,
            x,
            y,
            max_width,
            colour,
            fo,
            line_spacing=4,
            center=False
        ):

            words = str(text).split(" ")

            lines = []
            current_line = ""

            for word in words:

                if current_line == "":
                    test_line = word
                else:
                    test_line = current_line + " " + word

                if fo.size(test_line)[0] <= max_width:
                    current_line = test_line

                else:

                    if current_line != "":
                        lines.append(current_line)

                    # Handle a single word that is itself too long.
                    while fo.size(word)[0] > max_width:

                        cut = len(word)

                        while (
                            cut > 1
                            and fo.size(word[:cut])[0] > max_width
                        ):
                            cut -= 1

                        lines.append(word[:cut])
                        word = word[cut:]

                    current_line = word

            if current_line != "":
                lines.append(current_line)

            current_y = y

            for line in lines:

                if center:
                    w(
                        line,
                        x,
                        current_y,
                        colour,
                        fo,
                        center=True
                    )
                else:
                    w(
                        line,
                        x,
                        current_y,
                        colour,
                        fo
                    )

                current_y += fo.get_height() + line_spacing

            return current_y

