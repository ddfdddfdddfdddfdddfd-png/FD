        def purchase_item(key):

            nonlocal c
            nonlocal cc
            nonlocal ccc
            nonlocal bought_elixir_this_turn

            # -----------------------------
            # Sword
            # -----------------------------

            if key == "sword":

                if (
                    player.money >= 2
                    and player.bought["sword"] < 1
                ):
                    player.atk += 1
                    player.money -= 2
                    player.bought["sword"] += 1
                    return True

                return False

            # -----------------------------
            # Shield
            # -----------------------------

            if key == "shield":

                if (
                    player.money >= 2
                    and player.bought["shield"] < 1
                ):
                    player.df += 1
                    player.money -= 2
                    player.bought["shield"] += 1
                    return True

                return False

            # -----------------------------
            # Boots
            # -----------------------------

            if key == "boots":

                if (
                    player.artefact == "socks"
                    or player.money < 2
                    or player.bought["boots"] >= 1
                ):
                    return False

                if player.relic == "meowton":
                    player.extra_atk -= player.spd

                player.spd += 1
                player.money -= 2
                player.bought["boots"] += 1

                if player.relic == "meowton":
                    player.extra_atk += player.spd

                return True

            # -----------------------------
            # Battery
            # -----------------------------

            if key == "battery":

                if (
                    player.relic != "e-sword"
                    or player.bought["battery"] >= 5
                    or player.money < 2
                ):
                    return False

                player.counters += 1
                player.money -= 2
                player.bought["battery"] += 1

                return True

            # -----------------------------
            # Chicken
            # -----------------------------

            if key == "chicken":

                # Blessed KOC
                if player.relic == "bk":

                    if (
                        player.bought["chicken"] >= 1
                        or player.money < 2
                        or player.max_hp - player.hp < 5
                    ):
                        return False

                    player.hp += 7
                    player.money -= 2
                    player.bought["chicken"] += 1

                    if player.hp >= player.max_hp:
                        player.hp = player.max_hp

                    return True

                # S-KOC
                elif player.relic == "sk":

                    if (
                        player.bought["chicken"] >= 3
                        or player.money < 2
                        or player.max_hp - player.hp < 5
                    ):
                        return False

                    player.hp += 7
                    player.money -= 2
                    player.bought["chicken"] += 1

                    if player.hp >= player.max_hp:
                        player.hp = player.max_hp

                    return True

                # G-KOC
                elif player.relic == "gk":

                    if player.money < 2:
                        return False

                    player.hp = player.max_hp
                    player.money -= 2
                    player.bought["chicken"] += 1

                    return True

                # D-KOC
                elif player.relic == "dk":

                    player.hp = player.max_hp
                    player.money -= 2
                    player.bought["chicken"] += 1

                    if player.money < 0:
                        ac["negative_money"] = True

                    return True

                # Normal chicken
                else:

                    if (
                        player.bought["chicken"] >= 1
                        or player.money < 2
                        or player.max_hp - player.hp < 5
                    ):
                        return False

                    player.hp += 5
                    player.money -= 2
                    player.bought["chicken"] += 1

                    if player.yd3 == 4:
                        player.hp += 5

                    if player.hp >= player.max_hp:
                        player.hp = player.max_hp

                    return True

            # -----------------------------
            # Books
            # -----------------------------

            if key.startswith("book_"):

                book_key = key.split("_")[1]

                if (
                    player.books[book_key] >= 3
                    or player.money < 3
                ):
                    return False

                if book_key == "heal":

                    player.hp = player.max_hp

                elif book_key == "hp":

                    if player.socks_sealed:
                        # Preserve the behaviour of the original code:
                        # the purchase is counted but the 3 money is
                        # effectively refunded.
                        player.money += 3
                    else:
                        player.pending_hp_multiplier *= 2

                elif book_key == "spd":

                    if player.relic == "meowton":
                        player.extra_atk -= player.spd

                    player.spd *= 2

                    if player.relic == "meowton":
                        player.extra_atk += player.spd

                else:

                    attribute = (
                        "df"
                        if book_key == "def"
                        else book_key
                    )

                    setattr(
                        player,
                        attribute,
                        getattr(player, attribute) * 2
                    )

                player.books[book_key] += 1
                player.money -= 3

                return True

            # -----------------------------
            # Elixir
            # -----------------------------

            if key == "elixir":

                if (
                    player.bought_elixir_this_turn >= 1
                    or player.money < 1
                ):
                    return False

                player.money -= 1
                player.bought["elixir"] += 1
                player.bought_elixir_this_turn += 1

                bought_elixir_this_turn = (
                    player.bought_elixir_this_turn
                )

                player.max_hp -= player.bought["elixir"]

                if player.hp > player.max_hp:
                    player.hp = player.max_hp

                # Preserve the original shop-death behaviour.
                if player.hp <= 0:
                    ac["shop_death"] = True
                    return "dead"

                if player.relic == "meowton":
                    player.extra_atk -= (
                        player.extra_spd + player.spd
                    )

                player.spd -= 1
                player.extra_spd += 6

                if player.relic == "meowton":
                    player.extra_atk += (
                        player.extra_spd + player.spd
                    )

                # Counter restoration.
                if c == 0:
                    c = 3
                elif cc == 0:
                    cc = 3
                else:
                    ccc = 3

                return True

            # -----------------------------
            # Forbidden Ink
            # -----------------------------

            if key == "ink":

